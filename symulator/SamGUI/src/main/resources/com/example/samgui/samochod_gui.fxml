<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.samgui.SamochodController"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="Plik">
                        <MenuItem text="Zamknij"/>
                    </Menu>
                </menus>
            </MenuBar>
            <ToolBar>
                <Label text="Samochód: "/>
                <ComboBox fx:id="carComboBox" prefWidth="150.0"/>
                <Button fx:id="dodajNowyButton" text="Dodaj nowy" onAction="#onDodajNowyButton"/>
            </ToolBar>
        </VBox>
    </top>

    <left>
        <ScrollPane prefWidth="300.0">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <TitledPane text="Samochód" expanded="true">
                    <VBox spacing="5">
                        <Label text="Model:"/>
                        <TextField fx:id="modelTextField" editable="false"/>
                        <Label text="Rejestracja:"/>
                        <TextField fx:id="registrationTextField" editable="false"/>
                        <Label text="Waga:"/>
                        <TextField fx:id="weightTextField" editable="false"/>
                        <Label text="Prędkość:"/>
                        <TextField fx:id="speedTextField" editable="false"/>
                        <HBox spacing="10">
                            <Button fx:id="wlaczButton" text="Włącz" onAction="#onWlaczButton"/>
                            <Button fx:id="wylaczButton" text="Wyłącz" onAction="#onWylaczButton"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <TitledPane text="Skrzynia i Silnik" expanded="true">
                    <VBox spacing="5">
                        <Label text="Bieg:"/>
                        <TextField fx:id="gearTextField" editable="false"/>
                        <HBox spacing="5">
                            <Button fx:id="zwiekszBiegButton" text="+" onAction="#onZwiekszBiegButton"/>
                            <Button fx:id="zmniejszBiegButton" text="-" onAction="#onZmniejszBiegButton"/>
                        </HBox>
                        <Label text="Obroty:"/>
                        <TextField fx:id="rpmTextField" editable="false"/>
                        <HBox spacing="5">
                            <Button fx:id="zwiekszObrotyButton" text="+" onAction="#onZwiekszObrotyButton"/>
                            <Button fx:id="zmniejszObrotyButton" text="-" onAction="#onZmniejszObrotyButton"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <TitledPane text="Sprzęgło">
                    <VBox spacing="5">
                        <Label text="Stan:"/>
                        <TextField fx:id="clutchTextField" editable="false"/>
                        <HBox spacing="10">
                            <Button fx:id="wcisnijSprzegloButton" text="Wciśnij" onAction="#onWcisnijSprzegloButton"/>
                            <Button fx:id="zwolnijSprzegloButton" text="Zwolnij" onAction="#onZwolnijSprzegloButton"/>
                        </HBox>
                    </VBox>
                </TitledPane>
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <StackPane>
            <ImageView fx:id="carImageView" pickOnBounds="true" preserveRatio="true"/>
        </StackPane>
    </center>

</BorderPane>